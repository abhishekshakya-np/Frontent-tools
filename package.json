{
  "name": "frontend-collection",
  "version": "1.0.0",
  "description": "A comprehensive collection of responsive frontend websites showcasing modern web development techniques",
  "main": "index.html",
  "scripts": {
    "start": "live-server --port=8000 --open=index.html",
    "dev": "live-server --port=8000 --open=index.html --watch=.",
    "serve": "python -m http.server 8000",
    "open": "start index.html",
    "http": "http-server -p 8000 -o -c-1"
  },
  "keywords": [
    "frontend",
    "bootstrap",
    "responsive",
    "web-development",
    "templates",
    "html",
    "css",
    "javascript"
  ],
  "author": "Frontend Collection",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1",
    "live-server": "^1.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/frontend-collection.git"
  },
  "homepage": "https://your-username.github.io/frontend-collection/",
  "engines": {
    "node": ">=12.0.0"
  },
  "workspaces": [
    "showcase/projects/*",
    "showcase/office-work/*",
    "showcase/component-snippets/*",
    "showcase/email-templates/*",
    "showcase/portfolio/*",
    "showcase/website/*"
  ]
}
