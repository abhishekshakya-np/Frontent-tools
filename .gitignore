Office Work/Mind's Mirror - Mental Health Tracking Landing Page/node_modules/

# Keep only essential files from large projects
# Exclude development files but keep demos
**/bower_components/
**/vendor/
**/.git/
**/__MACOSX/
**/RecycleBin/

# Exclude source maps and development files
*.map
*.scss.map
*.css.map
*.js.map

# Exclude large documentation folders
**/documentation/
**/docs/build/
**/site/

# Exclude server-side files (keep for demo but exclude from git)
**/server/
**/*.php

# Keep main project files but exclude development artifacts
!index.html
!landing-style.css
!landing-script.js
!README.md
!package.json
!server.py
!start-local.bat
!start-local.ps1
