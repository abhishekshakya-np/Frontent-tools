# Frontend Collection Backend Configuration
# Copy this file to .env and customize the values

# Environment (development or production)
FLASK_ENV=development

# Secret key for session/JWT signing (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT secret key (defaults to SECRET_KEY if not set)
JWT_SECRET_KEY=

# JWT token expiration in hours (default: 24)
JWT_EXPIRY_HOURS=24

# Admin password for initial setup (optional)
# If not set, a secure random password will be generated on first run
ADMIN_PASSWORD=

# Server configuration
HOST=127.0.0.1
PORT=5001
DEBUG=false

# CORS origins (comma-separated list)
# Example: http://localhost:8000,http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001,http://localhost:8000,http://127.0.0.1:8000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_LOGIN=5/minute
